<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>EthangRss</AssemblyName>
    <RootNamespace>EthangRss.Desktop</RootNamespace>
  </PropertyGroup>

  <!-- Package as one self-contained executable, but only when publishing: keeping these on for
       every build makes the project unreferenceable from the test projects. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' or '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EthangRss.Core\EthangRss.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>

  <!-- Skia and HarfBuzz ship debug symbols as package content; they are not needed to run. -->
  <Target Name="StripNativeSymbols" AfterTargets="Publish">
    <ItemGroup>
      <Strippable Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(Strippable)" />
  </Target>

</Project>
