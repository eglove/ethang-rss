<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EthangRss.Desktop.ViewModels"
        x:Class="EthangRss.Desktop.Views.OnboardingWindow"
        x:DataType="vm:OnboardingViewModel"
        Title="Welcome to Ethang RSS"
        Width="560" Height="320"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="h1" Text="Welcome to Ethang RSS" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Classes="meta" TextWrapping="Wrap"
                   Text="Your library is empty. Add feeds with the Add feed button once you are in, by pasting either a feed address or just a website." />

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,20,0,0">
            <TextBlock Classes="kicker" Text="CHECK FOR NEW ARTICLES EVERY" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <NumericUpDown Value="{Binding RefreshIntervalMinutes}" Minimum="1" Maximum="1440" Width="120" />
                <TextBlock Text="minutes" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="3" Content="Start reading" HorizontalAlignment="Right" Padding="20,9" Click="OnDoneClick" />
    </Grid>
</Window>
