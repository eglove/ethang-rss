<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EthangRss.Desktop.ViewModels"
        x:Class="EthangRss.Desktop.Views.OnboardingWindow"
        x:DataType="vm:OnboardingViewModel"
        Title="Welcome to Ethang RSS"
        Width="620" Height="540"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="h1" Text="Welcome to Ethang RSS" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Classes="meta" TextWrapping="Wrap"
                   Text="This is a brand new library. You can bring your existing subscriptions across, or start with none and add feeds as you go." />

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,20,0,0">
            <TextBlock Classes="kicker" Text="BRING YOUR SUBSCRIPTIONS" />
            <TextBlock Classes="meta" TextWrapping="Wrap" Text="Export your Cloudflare database, then choose the file:" />
            <SelectableTextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding WranglerCommand}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding DumpPath, Mode=TwoWay}" Width="420"
                         Background="{StaticResource SurfaceSunkenBrush}" BorderBrush="{StaticResource LineBrush}" CornerRadius="6" Padding="8,6" />
                <Button Content="Browse..." Classes="ghost" Click="OnBrowseClick" />
            </StackPanel>
            <Button Content="Import from this file" Click="OnImportClick" HorizontalAlignment="Left" Padding="16,8" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8" Margin="0,20,0,0">
            <TextBlock Classes="kicker" Text="OR" />
            <Button Content="Start with an empty library" Classes="ghost" HorizontalAlignment="Left" Click="OnStartEmptyClick" />
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="6" Margin="0,20,0,0">
            <TextBlock Classes="kicker" Text="CHECK FOR NEW ARTICLES EVERY" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <NumericUpDown Value="{Binding RefreshIntervalMinutes}" Minimum="1" Maximum="1440" Width="120" />
                <TextBlock Text="minutes" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="5" Classes="meta" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,14,0,0" />

        <Button Grid.Row="6" Content="Let me read" HorizontalAlignment="Right" Padding="20,9" Click="OnDoneClick" />
    </Grid>
</Window>
